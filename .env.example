HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=.local/wikibot.sqlite
# Local operator token; inject through a secret manager for a real environment.
BOOTSTRAP_TOKEN=
BOOTSTRAP_SUBJECT=operator
# Company Anthropic-compatible endpoint, called through @earendil-works/pi-ai.
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=
# Direct API models omit CC's [1m] suffix. Model selection lives in reviewed bundles.
# Answer deadline in ms (default 15000; measured glm-5.3 answers run 5-11s).
ANSWER_DEADLINE_MS=15000
# Optional endpoint-specific thinking toggle; changing it requires quality review.
# No SLO or reasoning-quality claim follows from this setting.
MODEL_THINKING=
WECOM_ENABLED=0
# Proactive status notifications; enable after verifying member mapping.
WECOM_NOTIFICATIONS_ENABLED=0
WECOM_BOT_ID=
WECOM_SECRET=
WECOM_DOMAIN=ads
WECOM_MEMBERS_JSON={"<verified-callback-userid>":"<company-subject>"}
# Use the exact trusted callback from.userid, which may differ from the send address.
# Mapping alone grants no domain permissions. Configure membership through the platform API.
# Proactive addresses are independently verified; never infer them from callback ids.
WECOM_NOTIFICATION_RECIPIENTS_JSON={}
# Optional multi-bot array supersedes single-bot settings. Secrets reference env names.
# [{"botId":"<bot-a>","domain":"ads","secretEnv":"BOT_A_SECRET","members":{}},
#  {"botId":"<bot-b>","domain":"equipment","secretEnv":"BOT_B_SECRET","members":{}}]
WECOM_BOTS_JSON=
# Group Q&A also requires a trusted complete audience provider. The default server
# supplies none, so groups remain disabled even if allowlisted here.
WECOM_GROUPS_JSON=[]
# No automatic event cleanup until both an approved policy and duration are set.
OPERATIONAL_RETENTION_MS=
OPERATIONAL_RETENTION_POLICY=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
PLATFORM_SUBJECTS=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile
RECOVERY_MODE=0
RECOVERY_PROOF_URL=
RECOVERY_ISSUER=
RECOVERY_JWKS_URL=
