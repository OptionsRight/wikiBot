HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=.local/wikibot.sqlite
# Local operator token; inject through a secret manager for a real environment.
BOOTSTRAP_TOKEN=
BOOTSTRAP_SUBJECT=operator
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_AUTH_TOKEN=
# Direct API models omit CC's [1m] suffix. Model selection lives in reviewed bundles.
WECOM_ENABLED=0
# Proactive status notifications; enable after verifying member mapping.
WECOM_NOTIFICATIONS_ENABLED=0
WECOM_BOT_ID=
WECOM_SECRET=
WECOM_DOMAIN=ads
WECOM_MEMBERS_JSON={"<verified-callback-userid>":"rubychen"}
# Use the exact trusted callback from.userid, which may differ from the send address.
# Mapping alone grants no domain permissions. Grant rubychen member access explicitly.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
PLATFORM_SUBJECTS=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile
RECOVERY_MODE=0
RECOVERY_PROOF_URL=
RECOVERY_ISSUER=
RECOVERY_JWKS_URL=
