{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "attempt": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "fencingToken": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "sourceVersionId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    },
    "rawSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profileHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "doclingVersion": {
      "type": "string"
    },
    "startedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finishedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parseStatus": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "failed"
      ]
    },
    "warnings": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "blocks": {
      "maxItems": 50000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blockId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,100}$"
          },
          "kind": {
            "type": "string",
            "maxLength": 100
          },
          "text": {
            "type": "string",
            "maxLength": 200000
          },
          "contentHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "locator": {
            "type": "object",
            "properties": {
              "precision": {
                "type": "string",
                "enum": [
                  "document",
                  "block",
                  "page",
                  "slide",
                  "cells",
                  "lines"
                ]
              },
              "pointer": {
                "type": "string",
                "maxLength": 500
              },
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "sheet": {
                "type": "string",
                "maxLength": 300
              },
              "range": {
                "type": "string",
                "maxLength": 100
              },
              "startLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "bbox": {
                "minItems": 4,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "precision",
              "pointer"
            ],
            "additionalProperties": false
          },
          "extractionAllowed": {
            "type": "boolean"
          }
        },
        "required": [
          "blockId",
          "kind",
          "text",
          "contentHash",
          "locator",
          "extractionAllowed"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "document.json",
              "document.md",
              "blocks.json"
            ]
          },
          "rawSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "rawSha256",
          "bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "attempt",
    "fencingToken",
    "sourceVersionId",
    "rawSha256",
    "profileHash",
    "doclingVersion",
    "startedAt",
    "finishedAt",
    "parseStatus",
    "warnings",
    "blocks",
    "artifacts"
  ],
  "additionalProperties": false
}
